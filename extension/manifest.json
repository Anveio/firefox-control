{
  "manifest_version": 3,
  "name": "Local Control for Firefox",
  "version": "0.1.0",
  "description": "Control Firefox windows, tabs, frames and page scripts from your local CLI. Requires the Firefox Control native companion.",
  "browser_specific_settings": {"gecko": {"id": "firefox-control@anveio.com", "strict_min_version": "153.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}},
  "permissions": ["nativeMessaging", "storage", "tabs", "scripting", "webNavigation", "contextualIdentities", "cookies"],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["userScripts"],
  "background": {"scripts": ["page.js", "background.js"]},
  "action": {"default_title": "Enable local Firefox control and user scripts", "default_icon": "icon.svg"},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "options_ui": {"page": "options.html", "open_in_tab": true}
}
